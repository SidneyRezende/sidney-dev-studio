# ============================================================
# Modelo de configuração — SEM valores reais.
#
# 1. Copia este ficheiro para ".env" (o .env está no .gitignore).
# 2. Preenche a chave só no .env, nunca aqui.
# 3. Estas variáveis são lidas APENAS pelo servidor local de IA
#    (server/ia-servidor.ts, iniciado com: npm.cmd run ia),
#    nunca pelo frontend React.
#
# ATENÇÃO (Vite): variáveis com o prefixo VITE_ são incluídas no código
# que o navegador descarrega. NUNCA uses VITE_ em chaves API.
# ============================================================

# Chave da API Anthropic (Claude) — obrigatória para gerar texto
ANTHROPIC_API_KEY=

# --- Opcionais (sem segredos) ---

# Modelo usado pelo servidor (por omissão: claude-opus-5-5)
IA_MODELO=claude-opus-5-5

# Porta do servidor local. A app espera 8787 — só mudes se souberes o que fazes.
IA_SERVIDOR_PORTA=8787

# Origens da app autorizadas a usar o servidor (dev e preview do Vite)
IA_ORIGENS=http://localhost:5173,http://localhost:4173

# Limite local de pedidos por minuto (protege a fatura)
IA_MAX_POR_MINUTO=10

# Fallback automático da Anthropic: se o modelo recusar um pedido por política,
# tenta automaticamente um modelo alternativo na mesma chamada (pode ter custo extra).
# Valores: desligado (por omissão) | ligado
IA_FALLBACK=desligado
